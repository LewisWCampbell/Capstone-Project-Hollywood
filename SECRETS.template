# API Keys and Secrets for Project HOLLYWOOD
# Copy this file to 'SECRETS' (no extension) and fill in your actual keys
# NEVER commit the actual SECRETS file to git!

# OMDB API Key
# Get yours at: http://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_api_key_here

# Ollama Configuration (for local LLM)
# No API key needed for Ollama, but you can configure the endpoint
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Optional: OpenAI API Key (if using OpenAI instead of Ollama)
# Get yours at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_key_here

# Optional: Anthropic API Key (if using Claude API)
# Get yours at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional: Other movie data sources
# TMDB API Key: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_key_here

# Google Cloud Storage Configuration
# Required for GCS streaming mode
GCS_BUCKET_NAME=your-bucket-name
GCS_PROJECT_ID=your-gcp-project-id
GCS_CREDENTIALS_PATH=/path/to/service-account-key.json

# General Settings
# Set to 'production' or 'development'
ENVIRONMENT=development

# Hugging Face token (free) for cluster naming when Ollama is not running,
# e.g. on Streamlit Community Cloud. Create one at https://huggingface.co/settings/tokens
HF_TOKEN=your_hf_token_here
# Optional: override the naming model (OpenAI-compatible HF router model id)
# HF_MODEL=Qwen/Qwen3-8B:fastest   (default; ungated. Gated alternatives need a license click on HF)
